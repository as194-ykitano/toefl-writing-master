rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // 管理者のメールアドレスリスト
    function isAdmin() {
      return request.auth != null &&
        request.auth.token.email in [
          'info@english-gym.org', // 管理者（本番）
          'admin@gmail.com',    // 管理者のメールアドレス
          'admin@example.com',  // 管理者のメールアドレスをここに追加
          'ykita@example.com'   // あなたのメールアドレスを追加
        ];
    }

    // ユーザーコレクション全体 - 管理者のみが読み取り可能
    match /users/{userId} {
      // 個別ユーザーは自分の情報のみ読み取り・更新可能
      // これにはtrainingPermissions（TOEFL、IELTS、Basic、YouTuber、TOEFL Academic Discussion）も含まれる
      allow read, write: if request.auth != null && request.auth.uid == userId;
      // 管理者は全ユーザーの情報を読み取り・更新可能
      // 管理者はユーザーのトレーニング権限を設定可能
      allow read, update: if isAdmin();
      
      // サブコレクション
      match /essays/{essayId} {
        // ユーザーは自分のエッセイのみ読み取り・作成・更新・削除可能
        // これにはTOEFL、IELTS、TOEFL Academic Discussionの全エッセイが含まれる
        allow read, create, update, delete: if request.auth != null && request.auth.uid == userId;
        // 管理者は全ユーザーのエッセイを読み取り・更新・削除可能
        allow read, update, delete: if isAdmin();
      }
      // Basicトレーニング用エッセイサブコレクション
      match /basicEssays/{essayId} {
        // ユーザーは自分のBasicエッセイのみ読み取り・作成・更新・削除可能
        allow read, create, update, delete: if request.auth != null && request.auth.uid == userId;
        // 管理者は全ユーザーのBasicエッセイを読み取り・更新・削除可能
        allow read, update, delete: if isAdmin();
      }
      // YouTube Learning用エッセイサブコレクション
      match /youTuberEssays/{essayId} {
        allow read, create, update, delete: if request.auth != null && request.auth.uid == userId;
        // 管理者は全ユーザーのYouTuberエッセイを読み取り・更新・削除可能
        allow read, update, delete: if isAdmin();
      }
      match /studySessions/{sessionId} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }
      // prep 学習データ（演習セッション / Writing / YouTube / 模試）のユーザー別保存領域
      // ドキュメントID = ストアの base キー（prep_sessions_v1 等）、{ items, updatedAt } を保持
      match /appData/{storeId} {
        // 本人は自分の学習データを読み書き可能
        allow read, write: if request.auth != null && request.auth.uid == userId;
        // 管理者はユーザー詳細画面での閲覧用に読み取り可能
        allow read: if isAdmin();
      }
      // 単語・フレーズコレクション
      match /vocabulary/{vocabularyId} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }
    }
    
    // タスク - 認証されたユーザーが読み取り可能、管理者のみが作成・更新・削除可能
    // これにはTOEFL、IELTS、Basic、YouTuber、TOEFL Academic Discussionの全タスクが含まれる
    match /tasks/{taskId} {
      allow read: if request.auth != null;
      allow create, update, delete: if isAdmin();
    }

    // 新しい演習セット管理。通常画面は公開用APIを経由し、
    // Firestoreを直接読む場合も非公開データは管理者だけに限定する。
    match /practiceSets/{setId} {
      allow read: if request.auth != null && (resource.data.isPublished == true || isAdmin());
      allow create, update, delete: if isAdmin();
    }

    // 新仕様の使い方ガイド。公開記事はログインユーザー、編集は管理者のみ。
    match /guideArticles/{guideId} {
      allow read: if request.auth != null && (resource.data.isPublished == true || isAdmin());
      allow create, update, delete: if isAdmin();
    }

    // リーディングパッセージ - 認証されたユーザーが読み取り可能、管理者のみが作成・更新・削除可能
    match /readingPassages/{passageId} {
      allow read: if request.auth != null;
      allow create, update, delete: if isAdmin();
    }

    // YouTube Learning用タスク - 認証されたユーザーが読み取り可能、管理者のみが作成・更新・削除可能
    match /youTuberTasks/{taskId} {
      allow read: if request.auth != null;
      allow create, update, delete: if isAdmin();
    }

    // YouTube動画 - 認証されたユーザーが読み取り・作成可能、管理者のみが更新・削除可能
    match /youtubeVideos/{videoId} {
      allow read, create: if request.auth != null;
      allow update, delete: if isAdmin();
    }

    // エッセイコレクション（ルートレベル - 現在は使用されていない）
    match /essays/{essayId} {
      allow read: if request.auth != null && request.auth.uid == resource.data.userId;
      allow create: if request.auth != null && request.resource.data.userId == request.auth.uid;
      allow update, delete: if request.auth != null && request.auth.uid == resource.data.userId;
    }

    // ─── 動画コース（english-gym-admin から移植）───
    // コース本体: 公開コースは認証ユーザーが閲覧可、下書きや作成・編集は管理者のみ
    match /videoCourses/{courseId} {
      allow read: if request.auth != null && (resource.data.published == true || isAdmin());
      allow create, update, delete: if isAdmin();
    }
    // モジュール・レッスン: 認証ユーザーが閲覧可、編集は管理者のみ
    // （公開判定は親コースの published に依存。非公開コースの詳細はアプリ側で辿らない）
    match /videoCourseModules/{moduleId} {
      allow read: if request.auth != null;
      allow create, update, delete: if isAdmin();
    }
    match /videoCourseLessons/{lessonId} {
      allow read: if request.auth != null;
      allow create, update, delete: if isAdmin();
    }
    // 学習進捗: 本人のみ読み書き可（ドキュメントIDは {uid}__{courseId}、studentUid フィールド保持）
    match /videoCourseProgress/{progressId} {
      allow read: if request.auth != null &&
        (resource == null || resource.data.studentUid == request.auth.uid);
      allow create, update: if request.auth != null &&
        request.resource.data.studentUid == request.auth.uid;
      allow delete: if isAdmin();
    }
  }
}
